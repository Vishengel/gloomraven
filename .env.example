# Lights to control: MAC addresses for WiZ, light names for Hue. Leave empty to control all lights.
# Only used until a light selection is saved (to resources/light_selection.json, or /data in Docker)
# Run `uv run python -m gloomraven.main --list_lights --sl_type wiz` to find them
LIGHTS=[]

# Broadcast address for WiZ discovery. Set to your LAN broadcast, e.g. 192.168.178.255, if no lights are found
WIZ_BROADCAST_ADDRESS=255.255.255.255
